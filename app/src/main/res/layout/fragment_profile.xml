<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#85C1E9">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/abril_fatface"
        android:gravity="center"
        android:padding="10dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:typeface="serif" />
    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/abril_fatface"
        android:gravity="center"
        android:padding="10dp"
        android:text="PLAN DE CUENTAS\n(Para empresas comerciales)"
        android:textSize="18sp"
        android:typeface="serif"
        android:shadowColor="#5D6D7E"
        android:shadowDx="1"
        android:shadowDy="6"
        android:shadowRadius="8"
        android:textColor="#212F3C"/>

    <!-- ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Contenido de la ScrollView -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <!-- Encabezados de la tabla -->
                <TableRow>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:fontFamily="@font/archivo_black"
                        android:padding="10dp"
                        android:text="CÓDIGO Nº"
                        android:shadowColor="#5D6D7E"
                        android:shadowDx="1"
                        android:shadowDy="6"
                        android:shadowRadius="8"
                        android:textColor="#212F3C"
                        android:typeface="monospace" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3.5"
                        android:fontFamily="@font/archivo_black"
                        android:padding="10dp"
                        android:shadowColor="#5D6D7E"
                        android:shadowDx="1"
                        android:shadowDy="6"
                        android:shadowRadius="8"
                        android:textColor="#212F3C"
                        android:text="DESCRIPCIÓN"
                        android:typeface="monospace" />
                </TableRow>
                <!-- Datos de la tabla (fila adicional) -->
                <TableRow>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="100000"
                        android:textColor="#D81B60"
                        android:padding="10dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3.5"
                        android:text="ACTIVOS"
                        android:textColor="#000000"
                        android:padding="10dp" />
                </TableRow>

                <!-- Datos de la tabla (fila adicional) -->
                <TableRow>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="110000"
                        android:textColor="#D81B60"
                        android:padding="10dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3.5"
                        android:text="ACTIVOS CORRIENTES"
                        android:textColor="#000000"
                        android:padding="10dp" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="111000"
                        android:textColor="#D81B60"
                        android:padding="10dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3.5"
                        android:textColor="#000000"
                        android:text="EFECTIVO Y/O SU EQUIVALENTE"
                        android:padding="10dp" />
                </TableRow>
                <!-- Datos de la tabla (filas adicionales) -->
                <TableRow>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="111001"
                        android:textColor="#D81B60"
                        android:padding="10dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3.5"
                        android:textColor="#000000"
                        android:text="CAJA"
                        android:padding="10dp" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="111002"
                        android:textColor="#D81B60"
                        android:padding="10dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3.5"
                        android:textColor="#000000"
                        android:text="FONDO FIJO"
                        android:padding="10dp" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="111003"
                        android:textColor="#D81B60"
                        android:padding="10dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3.5"
                        android:text="BANCOS"
                        android:textColor="#000000"
                        android:padding="10dp" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="111004"
                        android:textColor="#D81B60"
                        android:padding="10dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3.5"
                        android:textColor="#000000"
                        android:text="INVERSIONES TEMPORALES"
                        android:padding="10dp" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="112000"
                        android:textColor="#D81B60"
                        android:padding="10dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3.5"
                        android:textColor="#000000"
                        android:text="CUENTAS POR COBRAR"
                        android:padding="10dp" />
                </TableRow>
                <!-- Datos de la tabla (filas adicionales) -->
                <TableRow>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="112001"
                        android:textColor="#D81B60"
                        android:padding="10dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3.5"
                        android:textColor="#000000"
                        android:text="CUENTAS POR COBRAR COMERCIALES"
                        android:padding="10dp" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="112002"
                        android:textColor="#D81B60"
                        android:padding="10dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3.5"
                        android:textColor="#000000"
                        android:text="OTRAS CUENTAS POR COBRAR"
                        android:padding="10dp" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="112003"
                        android:textColor="#D81B60"
                        android:padding="10dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3.5"
                        android:textColor="#000000"
                        android:text="CUENTAS POR COBRAR A EMPRESAS RELACIONADAS"
                        android:padding="10dp" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="112004"
                        android:textColor="#D81B60"
                        android:padding="10dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3.5"
                        android:textColor="#000000"
                        android:text="ANTICIPO A PROVEEDORES"
                        android:padding="10dp" />
                </TableRow>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <Button
                        android:id="@+id/activouno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ver mas de los Activos..."
                        android:textColor="#17202A"
                        android:textSize="18sp"
                        android:theme="@style/button3"
                        android:layout_marginBottom="8dp"/>

                    <Button
                        android:id="@+id/pasivos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="pasivos"
                        android:textColor="#17202A"
                        android:textSize="18sp"
                        android:theme="@style/button4"
                        android:layout_marginBottom="8dp"/>

                    <Button
                        android:id="@+id/patrimonio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="patrimonio"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:theme="@style/button5"
                        android:layout_marginBottom="8dp"/>

                    <!-- Nuevos botones -->
                    <Button
                        android:id="@+id/ingresos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ingresos"
                        android:textColor="#17202A"
                        android:textSize="18sp"
                        android:theme="@style/button6"
                        android:layout_marginBottom="8dp"/>

                    <Button
                        android:id="@+id/egresos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="egresos"
                        android:textColor="#17202a"
                        android:textSize="18sp"
                        android:theme="@style/button"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/abril_fatface"
                        android:gravity="center"
                        android:padding="10dp"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:typeface="serif" />
                </LinearLayout>




            </TableLayout>
        </ScrollView>
    </ScrollView>

</LinearLayout>

