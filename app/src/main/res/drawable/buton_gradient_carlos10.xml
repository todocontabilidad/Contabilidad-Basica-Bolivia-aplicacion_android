<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:startColor="#FBE9E7"
                android:endColor="#FF8A65"
                android:angle="135"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:left="0dp"
        android:top="2dp"
        android:right="0dp"
        android:bottom="4dp">
        <shape>
            <solid android:color="#22000000" /> <!-- Sombra más suave -->
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>