<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <!-- Fondo cuando se presiona -->
            <item>
                <shape>
                    <gradient
                        android:startColor="#C8E6C9"
                        android:endColor="#2E7D32"
                        android:angle="135"
                        android:type="linear" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- Sombra cuando se presiona -->
            <item android:left="0dp" android:top="2dp" android:right="0dp" android:bottom="4dp">
                <shape>
                    <solid android:color="#22000000" /> <!-- Sombra más suave -->
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <!-- Fondo predeterminado -->
            <gradient
                android:startColor="#85C1E9"
                android:endColor="#1976D2"
                android:angle="135"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
